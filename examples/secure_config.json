{
  "debug": false,
  "host": "127.0.0.1",
  "port": 8443,
  "tls": {
    "enabled": true,
    "cert": "/etc/ssl/certs/server.crt",
    "key": "/etc/ssl/private/server.key",
    "min_version": "TLSv1.2"
  },
  "password": "${DB_PASSWORD}",
  "secret_key": "${APP_SECRET_KEY}",
  "logging": {
    "level": "INFO",
    "format": "json",
    "output": "/var/log/app/app.log"
  },
  "rate_limit": {
    "enabled": true,
    "requests_per_minute": 100
  }
}
